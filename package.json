{
  "name": "lidr-io",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run blog:prepare",
    "build": "next build",
    "prebuild": "npm run blog:prepare",
    "postbuild": "tsx scripts/blog/finalize.ts",
    "start": "next start",
    "lint": "eslint",
    "blog:prepare": "tsx scripts/blog/prepare.ts",
    "blog:check": "BLOG_STRICT=1 tsx scripts/blog/prepare.ts --check",
    "test:unit": "vitest run",
    "build:fixtures": "BLOG_CONTENT_DIR=tests/fixtures/blog npm run build",
    "capture": "node scripts/capture/capture.mjs",
    "test:visual": "npm run build:fixtures && playwright test tests/visual --project=chromium",
    "test:a11y": "npm run build:fixtures && playwright test tests/a11y.spec.ts tests/functional.spec.ts tests/blog.spec.ts --project=chromium",
    "test:lighthouse": "npm run build:fixtures && lhci autorun",
    "typecheck:blog-mcp": "tsc -p workers/blog-mcp"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "exif-reader": "^2.0.3",
    "mdast-util-to-string": "^4.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satori": "^0.63.2",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wawoff2": "^2.0.1",
    "yaml": "^2.9.1"
  }
}
